# Ground truth: keep the template and README, ignore your real labeled file
# only if you want to keep it private from a public fork — for the actual
# submission to Inclusive Minds you SHOULD include ground_truth.json.
# ground_truth/ground_truth.json

# Artifacts (large run outputs) — keep small JSON results, ignore anything huge
artifacts/*.mp4
artifacts/*.wav

# Secrets, just in case
*.pem
*.key
secrets.*
